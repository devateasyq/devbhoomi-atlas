rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user document is readable and writable only by that user.
    // Firebase's own defaults allow any signed-in user to read every
    // document, including other people's progress. Publishing this is
    // not optional.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Nothing else in the database is reachable from a client at all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
